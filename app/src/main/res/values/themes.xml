<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Jarvis Sveglia</string>

    <color name="bg">#0E1013</color>
    <color name="card">#171A20</color>
    <color name="line">#2B303A</color>
    <color name="text">#ECEFF4</color>
    <color name="muted">#9AA2B1</color>
    <color name="accent">#C8F542</color>
    <color name="accent_ink">#11160A</color>
    <color name="warn">#FBBF24</color>

    <style name="Theme.JarvisSveglia" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_ink</item>
        <item name="colorSecondaryContainer">#2A3312</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.JarvisSveglia.Alarm">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:backgroundTint">@color/line</item>
    </style>
</resources>
